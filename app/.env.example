# Скопируйте нужные строки в свой app/.env и подставьте реальные значения.
# Этот файл — шаблон без секретов, в .env его содержимое НЕ переносить как есть.

PORT=3000

# Токен тестового бота от @BotFather
BOT_TOKEN=токен

# Поднимается через `docker compose up -d` из корня проекта (docker-compose.yml).
# Значения ниже соответствуют postgres/redis-сервисам оттуда "из коробки".
DATABASE_URL=postgresql://dedlinebot:dedlinebot@localhost:5433/dedlinebot
REDIS_URL=redis://localhost:6379
