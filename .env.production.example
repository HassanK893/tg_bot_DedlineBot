# Шаблон для .env РЯДОМ с docker-compose.prod.yml НА САМОМ VPS.
# Этот файл — только пример со значениями-заглушками, реальный .env на
# сервере в git не попадает (см. .gitignore). deploy.sh генерирует его
# автоматически при первом деплое со случайными паролями — руками трогать
# нужно только BOT_TOKEN (и то, если не хотите, чтобы deploy.sh спросил
# его в терминале).

BOT_TOKEN=токен_от_BotFather

# Домен, направленный на этот VPS — без слеша на конце.
PUBLIC_URL=https://skanix.ru

# Случайная строка (генерируется автоматически в deploy.sh) — часть пути
# вебхука + Telegram secret_token, чтобы левый POST на этот адрес не мог
# притвориться апдейтом от Telegram.
WEBHOOK_SECRET=сгенерируется_автоматически

# Postgres — те же значения идут и в саму строку подключения ниже.
POSTGRES_USER=dedlinebot
POSTGRES_PASSWORD=сгенерируется_автоматически
POSTGRES_DB=dedlinebot
# postgres/redis — имена сервисов в docker-compose.prod.yml, не localhost:
# приложение и БД сидят в одной docker-сети.
DATABASE_URL=postgresql://dedlinebot:сгенерируется_автоматически@postgres:5432/dedlinebot
REDIS_URL=redis://redis:6379

DEFAULT_TIMEZONE=Europe/Moscow
PORT=3000
NODE_ENV=production
